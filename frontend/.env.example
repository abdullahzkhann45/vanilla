# Public URL of the storefront (no trailing slash). Used by sitemap + robots.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Internal URL of the backend API that Next's server reaches directly (no trailing slash).
# The browser never sees this — browsers hit /api/* and Next rewrites to this host.
API_URL=https://api.your-domain.com
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave blank to disable analytics.
NEXT_PUBLIC_GA_ID=
# Optional analytics
NEXT_PUBLIC_META_PIXEL_ID=
