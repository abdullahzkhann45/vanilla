# --- required ---
PORT=4000
NODE_ENV=production
# MongoDB connection string. Atlas SRV URIs are supported.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/vanilla
# Must be at least 24 random characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string-at-least-24-chars
# Comma-separated list of storefront origins allowed by CORS (no trailing slash).
STOREFRONT_ORIGIN=https://your-domain.com,https://www.your-domain.com

# --- optional ---
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Number of reverse proxies in front of the API (used for req.ip / rate limits).
TRUST_PROXY=1
# From-address on outgoing mail (currently logged to console; swap for a provider).
MAIL_FROM=orders@your-domain.com

# --- first-run seed only ---
SEED_ADMIN_EMAIL=admin@your-domain.com
SEED_ADMIN_PASSWORD=change-this-after-first-login

# Push notifications for new orders (ntfy.sh topic). Leave blank to disable.
NTFY_TOPIC=

# --- preventive monitoring (optional) ---
# Topic for health/stock alerts. Falls back to NTFY_TOPIC when blank.
NTFY_ALERT_TOPIC=
# Warn when a variant drops to this many units or fewer.
LOW_STOCK_THRESHOLD=3
# Warn when a COD order stays unconfirmed longer than this many hours.
ORDER_BACKLOG_HOURS=24
